# Pursuit environment variables — names only. NEVER commit real values.
# Root for DB/Redis in docker compose below.
DATABASE_URL="postgresql://pursuit:pursuit@127.0.0.1:54329/pursuit?schema=public"
REDIS_URL="redis://127.0.0.1:63799"

# Web app
NEXT_PUBLIC_API_URL="http://127.0.0.1:4000/api/v1"

# Mobile app (must be reachable from the device — use your LAN IP on hardware)
EXPO_PUBLIC_API_URL="http://127.0.0.1:4000/api/v1"

# API server
PORT=4000
NODE_ENV=development
CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"

# OpenCode agent runtime (adapter verification: docs/TECHNICAL_AUDIT.md)
OPENCODE_BASE_URL="http://127.0.0.1:7334"
OPENCODE_PASSWORD=""           # password printed once by `opencode serve`; copy here at runtime
OPENCODE_MODEL="minimax-m3.1-flash-free"

# Runtime selection: "dev" = deterministic mock agent (CI-safe); "opencode" = real OpenCode server
AGENT_RUNTIME="dev"

# Storage: "local" | "s3". S3 driver additionally needs S3_* variables.
STORAGE_DRIVER="local"
DATA_DIR="./.data/storage"

# BYOM credential encryption: 64 hexadecimal characters (32 random bytes).
# Generate outside source control. No fallback key is used.
CONNECTION_ENCRYPTION_KEY=""

# Composio managed Gmail OAuth (operator project key + Gmail auth config).
# Each user authorizes their own Gmail; Google client credentials are optional
# when using Composio-managed auth. Restrict auth config scopes before launch.
COMPOSIO_API_KEY=""
COMPOSIO_GMAIL_AUTH_CONFIG_ID=""
# Enable with a Composio project verifier URL pointing at WEB_URL/app/settings.
# Composio requires public HTTPS for its verifier (use a tunnel in local dev).
COMPOSIO_CALLBACK_VERIFICATION="false"
WEB_URL="http://127.0.0.1:3000"

# Optional direct Gmail OAuth path. Register WEB_URL/app/settings as redirect URI.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Set false to disable the persistent autopilot polling worker.
AUTOPILOT_WORKER_ENABLED=true
