{
  "name": "@pursuit/discovery",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "bin": {
    "pursuit-discovery": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && esbuild src/index.ts --bundle --platform=node --format=cjs --outfile=dist/index.cjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "hunt": "tsx src/cli.ts hunt",
    "cli": "tsx src/cli.ts"
  },
  "dependencies": {
    "zod": "^4.0.14",
    "ipaddr.js": "^2.2.0",
    "parse5": "^7.3.0",
    "fast-xml-parser": "^5.3.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.9.2",
    "vitest": "^3.2.0",
    "esbuild": "^0.28.2"
  },
  "main": "dist/index.cjs",
  "types": "dist/index.d.ts",
  "engines": {
    "node": ">=22.13.0"
  }
}
