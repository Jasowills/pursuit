{
  "$schema": "https://turborepo.com/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**", ".expo/**"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"],
      "env": ["DATABASE_URL", "NODE_ENV", "AGENT_RUNTIME", "ENABLE_DEV_LOGIN"],
      "cache": false,
      "passThroughEnv": ["CHROMIUM_EXECUTABLE", "RESUME_STORAGE_DIR", "APPLICATION_STORAGE_DIR"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
